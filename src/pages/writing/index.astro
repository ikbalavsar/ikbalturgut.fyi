---
import { getCollection } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"
import WritingList from "@/components/WritingList.astro"

const writing = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => ({ slug: entry.id, ...entry.data }))

const clusterMeta = [
  {
    id: "backend-data-systems",
    label: "Backend & data systems",
    description: "APIs, analytical data, migrations, and the performance decisions underneath a product.",
  },
  {
    id: "ai-systems",
    label: "AI systems",
    description: "Reliable AI applications built around evidence, boundaries, evaluation, and recovery.",
  },
  {
    id: "engineering-practice",
    label: "Engineering practice",
    description: "Testing, observability, API design, and system boundaries for systems that keep changing.",
  },
] as const

const clusters = clusterMeta.map((cluster) => ({
  ...cluster,
  items: writing.filter((entry) => entry.cluster === cluster.id),
}))
---

<BaseLayout
  title="Writing — Ikbal Turgut"
  description="Essays and notes on engineering, systems, and product craft."
>
  <header class="page-head section">
    <div class="shell">
      <span class="mono-label">The writing</span>
      <h1 class="page-title font-serif">
        Notes on building software with intent.
      </h1>
      <p class="page-lede">
        Longer-form thinking on the craft of engineering — clarity, systems, performance,
        and the decisions that quietly shape a product.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="shell">
      <nav class="topic-nav" aria-label="Writing topics">
        {clusters.map((cluster) => (
          <a href={`#${cluster.id}`} class="topic-nav__link">
            <span>{cluster.label}</span>
            <span class="mono-label">{cluster.items.length || "Next"}</span>
          </a>
        ))}
      </nav>

      <div class="topic-clusters">
        {clusters.map((cluster) => (
          <section id={cluster.id} class="topic-cluster">
            <div class="topic-cluster__head">
              <div>
                <span class="mono-label">Topic cluster</span>
                <h2 class="topic-cluster__title font-serif">{cluster.label}</h2>
                <p class="topic-cluster__desc">{cluster.description}</p>
              </div>
              <span class="mono-label">
                {cluster.items.length ? `${cluster.items.length} articles` : "Coming next"}
              </span>
            </div>
            {cluster.items.length ? (
              <WritingList items={cluster.items} />
            ) : (
              <p class="topic-cluster__empty">
                New notes on testing, observability, API design, and system boundaries will live here.
              </p>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    border-top: none;
    padding-bottom: 0;
  }
  .page-title {
    font-weight: 300;
    font-size: clamp(2.4rem, 5.5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 1.25rem;
    max-width: 16ch;
    text-wrap: balance;
  }
  .page-lede {
    margin-top: 1.5rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--ink-70);
    max-width: 52ch;
  }
  .topic-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .topic-nav__link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    border-top: var(--rule-strong);
    color: var(--ink);
  }
  .topic-nav__link:hover {
    color: var(--cobalt);
  }
  .topic-clusters {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 6rem);
  }
  .topic-cluster__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }
  .topic-cluster__title {
    margin-top: 0.65rem;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 300;
    line-height: 1;
  }
  .topic-cluster__desc {
    margin-top: 0.8rem;
    color: var(--ink-70);
    max-width: 52ch;
  }
  .topic-cluster__empty {
    padding: 1.25rem 0;
    border-block: var(--rule);
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .topic-nav {
      grid-template-columns: 1fr;
    }
    .topic-cluster__head {
      align-items: start;
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
