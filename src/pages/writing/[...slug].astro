---
import { getCollection, render } from "astro:content"
import BaseLayout from "@/layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => !data.draft)
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
---

<BaseLayout
  title={`${entry.data.title} — Ikbal Turgut`}
  description={entry.data.description}
  ogType="article"
>
  <article class="article">
    <div class="shell">
      <a href="/writing" class="back textlink">
        <span class="arrow">&#8592;</span> All writing
      </a>

      <header class="article-head">
        <div class="article-meta">
          <span class="article-tag">{entry.data.tag}</span>
          <time datetime={entry.data.date.toISOString()} class="mono-label">
            {fmt(entry.data.date)}
          </time>
          {entry.data.readingTime && <span class="mono-label">{entry.data.readingTime}</span>}
        </div>
        <h1 class="article-title font-serif">{entry.data.title}</h1>
        <p class="article-desc">{entry.data.description}</p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="article-foot">
        <span class="mono-label">End of note</span>
        <a href="/writing" class="textlink">More writing <span class="arrow">&#8594;</span></a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 8vw, 7rem);
  }
  .back {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .article-head {
    max-width: 65ch;
    padding-bottom: clamp(2rem, 4vw, 3rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: var(--rule-strong);
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .article-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    border: var(--rule);
    padding: 3px 9px;
  }
  .article-title {
    font-weight: 300;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .article-desc {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-70);
    font-family: var(--font-serif);
    font-style: italic;
  }
  .article-foot {
    max-width: 65ch;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
