---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout title="Not found — Ikbal Turgut" description="This page could not be found.">
  <section class="notfound">
    <div class="shell notfound-inner">
      <span class="mono-label">Error 404 — Broken edge</span>
      <h1 class="notfound-code font-serif">404</h1>
      <p class="notfound-msg">
        This node isn't connected to anything. The page you're looking for may have moved,
        been renamed, or never existed in the first place.
      </p>
      <div class="notfound-links">
        <a href="/" class="textlink">Back to home <span class="arrow">&#8594;</span></a>
        <a href="/writing" class="textlink">Read the writing <span class="arrow">&#8594;</span></a>
      </div>

      <svg class="notfound-map" viewBox="0 0 320 120" aria-hidden="true">
        <line x1="20" y1="60" x2="120" y2="60" stroke="var(--ink)" stroke-width="1" stroke-opacity="0.4" />
        <line x1="200" y1="60" x2="300" y2="60" stroke="var(--ink)" stroke-width="1" stroke-dasharray="4 4" stroke-opacity="0.4" />
        <circle cx="20" cy="60" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.4" />
        <circle cx="120" cy="60" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.4" />
        <rect x="196" y="56" width="8" height="8" fill="var(--lime)" stroke="var(--ink)" stroke-width="1.4" />
        <circle cx="300" cy="60" r="6" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.4" />
        <text x="150" y="52" font-family="var(--font-mono)" font-size="9" fill="var(--cobalt)">// disconnected</text>
      </svg>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    min-height: 70vh;
    display: grid;
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .notfound-code {
    font-weight: 300;
    font-size: clamp(5rem, 18vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-top: 1rem;
  }
  .notfound-msg {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: var(--ink-70);
  }
  .notfound-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 2rem;
  }
  .notfound-map {
    width: 100%;
    max-width: 320px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
</style>
